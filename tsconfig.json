{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "@cloudflare/vitest-plugin/types", "./worker-configuration.d.ts"]
  },
  "include": ["src", "tests", "vite.config.ts", "vitest.config.ts", "worker-configuration.d.ts"]
}
