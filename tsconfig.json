{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "node", "@cloudflare/workers-types"],
    "allowJs": true
  },
  "include": [
    "src",
    "tests",
    "evals",
    "scripts/eval-injection.ts",
    "scripts/migrations.mjs",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
