PUBLIC_ORIGIN=http://localhost:8789
APP_ENV=development
# open | closed. closed stops new sign-ups; existing owners keep working.
SIGNUP_MODE=open
SIGNUP_DAILY_CAP=200
TURSO_DATABASE_URL=file:.state/development.db
# Message encryption key (32 random bytes, base64url). Generate one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotation: add MESSAGE_KEY_V2; new messages use the highest version, then run
# scripts/rekey-messages.mjs. Never commit real keys.
MESSAGE_KEY_V1=
# TURSO_AUTH_TOKEN is injected by the Vercel Turso integration for hosted environments.
# CRON_SECRET must be a random secret set in Vercel, never committed here.
